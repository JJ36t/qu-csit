{
  // ── Python (API) ──
  "python.defaultInterpreterPath": "${workspaceFolder}/api/.venv/bin/python",
  "python.terminal.activateEnvironment": true,
  "python.testing.pytestEnabled": true,
  "python.testing.pytestArgs": ["tests"],
  "python.testing.cwd": "${workspaceFolder}/api",
  "python.analysis.extraPaths": ["${workspaceFolder}/api"],

  // ── Format on save ──
  "editor.formatOnSave": true,
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.codeActionsOnSave": {
      "source.fixAll.ruff": "explicit",
      "source.organizeImports.ruff": "explicit"
    }
  },
  "[dart]": {
    "editor.defaultFormatter": "Dart-Code.dart-code"
  },
  "[typescript]": {
    "editor.defaultFormatter": "dbaeumer.vscode-eslint"
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },

  // ── Files to hide from explorer ──
  "files.exclude": {
    "**/__pycache__": true,
    "**/.pytest_cache": true,
    "**/.venv": true,
    "**/node_modules": true,
    "**/.dart_tool": true,
    "**/build": true,
    "**/.ruff_cache": true,
    "**/.mypy_cache": true,
    "**/*.db": true,
    "**/*.db-journal": true,
    "**/dist": true,
    "**/storage": true
  },
  "search.exclude": {
    "**/__pycache__": true,
    "**/.venv": true,
    "**/node_modules": true,
    "**/.dart_tool": true,
    "**/build": true,
    "**/*.lock": true,
    "**/package-lock.json": true
  },

  // ── Terminal ──
  "terminal.integrated.defaultProfile.linux": "bash",
  "terminal.integrated.scrollback": 10000,

  // ── Editor ──
  "editor.tabSize": 4,
  "editor.insertSpaces": true,
  "editor.rulers": [100],
  "editor.wordWrap": "on",
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,

  // ── Git ──
  "git.autofetch": true,
  "git.confirmSync": false,
  "gitlens.currentLine.enabled": false,
  "gitlens.codeLens.enabled": false,

  // ── Save ──
  "files.autoSave": "afterDelay",
  "files.autoSaveDelay": 1000,

  // ── Arabic support ──
  "editor.fontFamily": "'Cairo', 'IBM Plex Sans Arabic', 'Segoe UI', monospace",
  "terminal.integrated.fontFamily": "monospace"
}
