# ─────────────────────────────────────────────────────────────
# QU-CSIT API — example environment. Copy to .env and edit.
# NEVER commit the real .env.
# ─────────────────────────────────────────────────────────────

# ── App ──
APP_NAME=QU-CSIT API
APP_ENV=development            # development | staging | production
APP_DEBUG=true
APP_TIMEZONE=Asia/Baghdad      # display timezone
APP_WEEK_START=sunday           # sunday | monday

# ── Database ──
# Dev (SQLite, no Docker needed):
DATABASE_URL=sqlite:///./dev.db
# Prod (Docker Compose):
# DATABASE_URL=postgresql+psycopg2://csit:csit@postgres:5432/csit
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ── Redis (background jobs / rate limit) ──
REDIS_URL=redis://localhost:6379/0
# If empty, the API falls back to inline job execution and in-memory rate-limit.

# ── Security ──
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALG=HS256
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30
LOGIN_RATE_PER_MIN=5

# Argon2id (OWASP tier)
ARGON2_MEMORY_KIB=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# ── Attendance rules (tune after Gate Q2) ──
LATE_THRESHOLD_MINUTES=15
ABSENCE_LIMIT_PERCENT=25
LATE_COUNTS_AS_ABSENCE=false

# ── Device binding ──
MAX_ACTIVE_DEVICES_PER_STUDENT=1

# ── File storage ──
# local | s3
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./storage
STORAGE_BASE_URL=http://localhost:8000/storage
# S3 (prod):
# STORAGE_BACKEND=s3
# S3_BUCKET=csit-files
# S3_REGION=eu-central-1
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...

# Upload limits
UPLOAD_MAX_BYTES=52428800      # 50 MB
UPLOAD_ALLOWED_MIME=application/pdf,video/mp4,image/png,image/jpeg

# ── FCM (notifications) ──
# Leave empty in dev → notification jobs log and no-op.
FIREBASE_CREDENTIALS_JSON=

# ── CORS ──
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Sentry (prod) ──
SENTRY_DSN=

# ── OpenApp / package (set after Gate Q1) ──
APP_PACKAGE_ID=iq.edu.qu.csit
